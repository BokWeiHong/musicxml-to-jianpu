# ---------------------------------------------------------------------------
# Jianpu Converter (.musicxml -> 简谱 PDF) - repository ignore rules
# ---------------------------------------------------------------------------

# --- Python runtime / virtualenv -------------------------------------------
.venv/
venv/
env/
ENV/
samples/
__pycache__/
*.py[cod]
*$py.class
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
how to publish release.txt

# --- PyInstaller build output ----------------------------------------------
# dist/ and build/ are regenerated with:
#     python patch_jianpu_ly_src.py   # regenerates jianpu_ly_patched/
#     pyinstaller JianpuConverter.spec
build/
dist/
*.spec.bak

# --- Pre-patched jianpu_ly copy (regenerated by patch_jianpu_ly_src.py) ----
jianpu_ly_patched/

# --- Bundled third-party engines / toolchains (vendor binaries) ------------
# The portable LilyPond 2.26 engine and the NSIS compiler are large binary
# trees; keep them out of git and re-supply them next to a build/dist instead.
/lilypond-2.26.0/
tools/
release/

# --- Generated converter output --------------------------------------------
# PDFs are written next to the input MusicXML file.
*_jianpu.pdf
*.pdf
*.ly
*.midi

# --- OS / editor noise ------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*~
*.tmp
